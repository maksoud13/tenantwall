# ─── Stage 1: build app ───
FROM maven:3.9-eclipse-temurin-21 AS app-build
WORKDIR /build
COPY pom.xml .
COPY src ./src
RUN mvn -q -DskipTests package

# ─── Stage 2: runtime ───
FROM eclipse-temurin:21-jre
WORKDIR /app

COPY --from=app-build /build/target/store-app.jar /app/app.jar
COPY tenantwall-agent.jar /app/tenantwall-agent.jar
COPY tenantwall.properties /app/tenantwall.properties

ENV JAVA_TOOL_OPTIONS="-javaagent:/app/tenantwall-agent.jar=/app/tenantwall.properties"
ENV SPRING_PROFILES_ACTIVE=docker

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]