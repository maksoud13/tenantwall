# ═══ TenantWall Parser Environment ═══
# This file is ignored by git (.gitignore) to protect secrets.

# The secret used to sign/verify JWTs between Java Agent and Python Parser
# MUST match `tenantwall.parser.secret` in your Java application.
TENANTWALL_PARSER_SECRET=change-me-to-a-random-32-char-string

# Number of Uvicorn workers (usually = number of CPU cores)
TENANTWALL_PARSER_WORKERS=4

# Enforce JWT authentication
TENANTWALL_PARSER_ENFORCE_AUTH=1

# Port mapping (Default is localhost only for safety)
# If you need the parser to be accessible from outside the host, change this to:
# TENANTWALL_PARSER_PORT_MAPPING=0.0.0.0:8000:8000